# ==============================================================================
# DoodleRush Environment Configuration Template
# Copy to .env.local (for Next.js web app) or .env (for realtime server)
#
# DO NOT COMMIT REAL SECRETS OR PRODUCTION VALUES TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY CONFIGURATION (apps/server)
# These variables are accessed ONLY by the Node.js realtime server.
# NEVER prefix these with NEXT_PUBLIC_.
# ------------------------------------------------------------------------------

# TCP port for the Socket.IO HTTP server.
PORT=3001

# Allowed web origin(s) permitted to connect to the Socket.IO server via CORS.
# Development: http://localhost:3000
# Production: MUST be an explicit HTTPS origin (or comma-separated HTTPS origins).
# Wildcards (*), paths, query strings, and credentials are strictly rejected.
WEB_ORIGIN=http://localhost:3000

# Reverse Proxy Trust Setting.
# Set to 'true' or '1' ONLY if the server is deployed behind a trusted reverse proxy
# (e.g. Nginx, Caddy, Cloudflare, AWS ALB) that provides a valid X-Forwarded-For header.
# When true, the first IP in X-Forwarded-For is used for peer rate limiting.
# When false (default), the direct socket remote address is used.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. PUBLIC BROWSER CONFIGURATION (apps/web)
# This variable is baked into the Next.js client bundle.
# NEXT_PUBLIC_SOCKET_URL is the ONLY intentionally public endpoint configuration.
# ------------------------------------------------------------------------------

# Realtime WebSocket/Socket.IO server URL accessible by players' browsers.
# Development: http://localhost:3001
# Production: MUST be an explicit HTTPS/WSS URL without paths, credentials, or query strings.
# Build-time validation fails fast if missing or invalid during 'next build'.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
