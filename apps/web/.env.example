# ==============================================================================
# DoodleRush Web Frontend Configuration (apps/web)
#
# Copy to .env.local for local Next.js development.
# ==============================================================================

# URL of the DoodleRush realtime Socket.IO server accessible by browser clients.
# Development default: http://localhost:3001
# Production requirement: MUST be a valid HTTPS/WSS URL without query parameters or credentials.
# Note: Next.js validates this at build-time ('next build') and fails fast if invalid.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
