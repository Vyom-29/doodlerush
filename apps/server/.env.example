# ==============================================================================
# DoodleRush Realtime Server Configuration (apps/server)
#
# Copy to .env in production deployment environments.
# ==============================================================================

# TCP port to bind the HTTP / Socket.IO server.
PORT=3001

# Allowed web origin(s) permitted to connect via CORS.
# Development default: http://localhost:3000
# Production requirement: MUST be explicit HTTPS origin(s), comma-separated.
# Wildcards (*), paths, query strings, and credentials are intentionally rejected.
WEB_ORIGIN=http://localhost:3000

# Set to true or 1 when running behind a trusted reverse proxy (Nginx, Caddy, etc.)
# so that rate limiting uses the peer IP from X-Forwarded-For instead of the proxy IP.
TRUST_PROXY=false
